# Core models
CLASSIFIER_MODEL_ID=hr16/PhoWhisper-small-vispeech-classifier-v3
VIETNAMESE_ASR_MODEL_ID=vinai/PhoWhisper-medium
# Improves English/code-switching; set blank to save VRAM and use only PhoWhisper.
MIXED_ASR_MODEL_ID=openai/whisper-small

# auto | cpu | cuda | mps
DEVICE=auto
# float32 | float16 | bfloat16
TORCH_DTYPE=float16
ENABLE_CLASSIFIER=true
ENABLE_MIXED_ASR=true

# Streaming/VAD (browser sends 16 kHz mono PCM16)
SAMPLE_RATE=16000
VAD_AGGRESSIVENESS=2
MIN_UTTERANCE_MS=400
END_SILENCE_MS=700
MAX_UTTERANCE_SECONDS=28
PRE_ROLL_MS=300

# Far-field cleanup
HIGH_PASS_HZ=80
TARGET_RMS_DB=-22
MAX_GAIN_DB=24

# Server
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
